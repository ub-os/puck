{
	"presets": ["@babel/preset-env"],
	"plugins": [
		["@babel/plugin-transform-react-jsx", { "pragma": "jsx" }],
		["@babel/plugin-proposal-decorators", { "version": "2023-01" }],
		["@babel/plugin-transform-private-methods"],
		[
			"module-resolver",
			{
				"cwd": "babelrc",
				"root": ["./"],
				"alias": {
					"~": "./puck/Resources/Private/JavaScript"
				}
			}
		]
	],
	"comments": false
}
