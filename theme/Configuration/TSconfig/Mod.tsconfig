// Content Wizard Groups
mod.wizards.newContentElement.wizardItems {
    01_content {
        header = Content
    }
    02_menu {
        header = Menu
    }
    menu.show =
    common.show =
    forms.show =
}
// Page Backend Layouts
allowedContent = list, shortcut, html, theme_accordions, theme_anchor, theme_cards, theme_columns, theme_full_width_media, theme_media, theme_menu_anchors, theme_menu_pages, theme_stage, theme_stage_carousel, theme_text
mod.web_layout.BackendLayouts {
    home {
        title = Home
        config {
            backend_layout {
                colCount = 8
                rowCount = 2
                rows {
                    1 {
                        columns {
                            1 {
                                name = Main content
                                colPos = 1
                                colspan = 8
                                allowed {
                                    CType < allowedContent
                                }
                            }
                        }
                    }
                    2 {
                        columns {
                            1 {
                                name = Footer
                                colPos = 3
                                colspan = 6
                                allowed {
                                    CType = theme_text
                                }
                            }
                            2 {
                                name = Modals
                                colPos = 9
                                colspan = 2
                                allowed {
                                    CType = theme_modal
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    default {
        title = Default
        config {
            backend_layout {
                colCount = 8
                rowCount = 2
                rows {
                    1 {
                        columns {
                            1 {
                                name = Main content
                                colPos = 1
                                colspan = 8
                                allowed {
                                    CType < allowedContent
                                }
                            }
                        }
                    }
                    2 {
                        columns {
                            1 {
                                name = Footer
                                colPos = 3
                                colspan = 6
                                allowed {
                                    CType = theme_text
                                }
                            }
                            2 {
                                name = Modals
                                colPos = 9
                                colspan = 2
                                allowed {
                                    CType = theme_modal
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    plugin-detail {
        title = Plugin detail page
        config {
            backend_layout {
                colCount = 8
                rows {
                    1 {
                        columns {
                            1 {
                                name = Main content
                                colPos = 1
                                colSpan = 8
                                allowed {
                                    CType = list
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}