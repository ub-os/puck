@import 'EXT:theme/Configuration/_Libs/_*.typoscript'

lib.currentYear = COA
lib.currentYear {
    10 = TEXT
    10 {
        data = date:U
        strftime = %Y
        wrap = &nbsp;|&nbsp;
    }
}

lib.rootpid = TEXT
lib.rootpid.data = leveluid : 0

lib.pagetitle = TEXT
lib.pagetitle.data = page : title

lib.language = TEXT
lib.language.data = sitelanguage:twoLetterIsoCode

lib.formatAnchorId = TEXT
lib.formatAnchorId {
    current = 1
    stdWrap.replacement {
        10 {
            search.char = 32
            replace = -
        }
    }
    stdWrap.case = lower
}

lib.dataProcessors {
    dataProcessing {
        inline_textmedia = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
        inline_textmedia {
            table = tx_theme_domain_model_inline_textmedia
            pidInList.field = pid
            where {
                data = field:uid
                intval = 1
                wrap = parent_uid=|
            }
            orderBy = sorting
            as = items
            dataProcessing {
                10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
                10 {
                    references.fieldName = assets
                }
            }
        }
    }
}