plugin.tx_powermail {
    view {
        templateRootPaths {
            100 = EXT:theme/Resource/Private/Fluid/Powermail/Templates
        }
        partialRootPaths {
            100 = EXT:theme/Resource/Private/Fluid/Powermail/Partials
        }
    }
    settings {
        javascript {
            addJQueryFromGoogle = 0
            addAdditionalJavaScript = 0
            powermailJQuery >
        }
        setup.validation.client = 0
        setup.spamshield._enable = 1
        }
    }
}
plugin.tx_powermail.settings.setup.main.optin = 0