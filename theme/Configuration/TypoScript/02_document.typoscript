page = PAGE
page.5 >
page.1 = TEXT

## css & js
page.includeCSS {
    main = {$cssProd}
}
page.includeJSFooter {
    app =  {$jsProd}
    app.defer = 0
}
[{$development} == 1]
    page.includeCSS.main = {$cssDev}
    page.includeJSFooter.app = {$jsDev}
[END]

## Meta
page.meta {
    X-UA-Compatible = IE=edge
    X-UA-Compatible.attribute = http-equiv
    viewport = width=device-width,initial-scale=1.0
    robots = index,follow
    description.data = DB:pages:1:description
    description.override.field = description
    keywords.field = keywords
    twitter:card = summary
    og:type = Website
    og:site_name.data = DB:pages:1:title
    og:title.field = seo_title
    og:description.field = description
}
[page["og_title"]]
    page.meta.og:title.field = og_title
[end]
[page["og_description"]]
    page.meta.og:description.field = og_description
[end]
[!page["og_image"]]
    page.headerData.40 < lib.ogImageFallback
[end]
## page title
[page["seo_title"]]
    config.noPageTitle = 2
    page.headerData.50 = TEXT
    page.headerData.50.field = seo_title
    page.headerData.50.wrap = <title>|</title>
[end]

page.bodyTag >
page.bodyTagCObject = TEXT
page.bodyTagCObject.stdWrap.dataWrap = <body class="d-body u-no-transition -layout-{pagelayout} " id="page-{field:uid}">

page.shortcutIcon = typo3conf/ext/theme/Resources/Public/images/favicons/favicon.ico

page.headerData.110 = TEXT
page.headerData.110.value (

)

page.headerData.120 = TEXT
page.headerData.120.value (
)
