@import 'EXT:theme/Configuration/_Content/_CTypes/CTypes.typoscript'
@import 'EXT:theme/Configuration/_Content/*/*.typoscript'

// Render Content Elements
lib.contentElement {
    partialRootPaths {
        100 = EXT:theme/Resources/Private/Templates/Fsc/Partials/
        200 = EXT:theme/Resources/Private/Fluid/Content/Partials/
    }
    templateRootPaths {
        100 = EXT:theme/Resources/Private/Templates/Fsc/Templates/
        200 = EXT:theme/Resources/Private/Fluid/Content/
    }
    layoutRootPaths {
        100 = EXT:theme/Resources/Private/Templates/Fsc/Layouts/
        200 = EXT:theme/Resources/Private/Fluid/Content/Layouts/
    }
    settings {
        media {
            additionalConfig {
                no-cookie = 1
                modestbranding = 1
                relatedVideos = 0
                showinfo = 0
                loop = 1
            }
        }
    }
}
lib.content {
    render = CONTENT
    render {
        table = tt_content
        select {
            orderBy = sorting
            where.cObject = COA
            where.cObject {
                10 = TEXT
                10 {
                    field = colPos
                    intval = 1
                    ifEmpty = 0
                    noTrimWrap = | AND colPos=||
                }
            }
        }
    }
    inherit = CONTENT
    inherit {
        table = tt_content
        slide = -1
        select {
            orderBy = sorting
            where.cObject = COA
            where.cObject {
                10 = TEXT
                10 {
                    field = colPos
                    intval = 1
                    ifEmpty = 0
                    noTrimWrap = | AND colPos=||
                }
            }
        }
    }
}
