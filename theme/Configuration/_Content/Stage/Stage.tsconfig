TCEFORM.tt_content {

    header.types.stage.label = Headline H1
    header_layout.types.stage.disabled = 1
    header_position.types.stage.disabled = 1
    subheader.types.stage.disabled = 1
    layout.types.stage {
        disabled = 0
        keepItems = default
    }
    imageorient.types.stage {
        disabled = 0
        keepItems = 3,4
    }
    imagecols.types.stage {
        disabled = 1
    }
}
[page["backend_layout"] == 'pagets__home']
    TCEFORM.tt_content {
        layout.types.stage {
            disabled = 0
            keepItems = stage-home
        }
    }
[end]