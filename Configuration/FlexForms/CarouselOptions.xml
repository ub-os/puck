<T3DataStructure>
    <sheets>
        <general>
            <ROOT>
                <sheetTitle>General</sheetTitle>
                <type>array</type>
                <el>
                    <carousel.splideOptions.type>
                        <label>Type</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <numIndex index="0">slide</numIndex>
                                    <numIndex index="1">slide</numIndex>
                                </numIndex>
                                <numIndex index="1">
                                    <numIndex index="0">loop</numIndex>
                                    <numIndex index="1">loop</numIndex>
                                </numIndex>
                            </items>
                            <default>slide</default>
                        </config>

                    </carousel.splideOptions.type>
                    <carousel.splideOptions.rewind>

                        <label>Rewind</label>
                        <displayCond>FIELD:carousel.splideOptions.type:IN:slide,fade</displayCond>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>

                    </carousel.splideOptions.rewind>
                    <carousel.splideOptions.arrows>

                        <label>Arrows</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>

                    </carousel.splideOptions.arrows>
                    <carousel.splideOptions.pagination>

                        <label>Pagination</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>

                    </carousel.splideOptions.pagination>
                    <carousel.trackOverflow>

                        <label>Overflow slider track</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <numIndex index="0">hidden</numIndex>
                                    <numIndex index="1">hidden</numIndex>
                                </numIndex>
                                <numIndex index="1">
                                    <numIndex index="0">visible</numIndex>
                                    <numIndex index="1">visible</numIndex>
                                </numIndex>
                            </items>
                            <default>hidden</default>
                        </config>

                    </carousel.trackOverflow>
                    <carousel.splideOptions.speed>

                        <label>Slide transition speed (in milliseconds)</label>
                        <config>
                            <type>input</type>
                            <eval>int</eval>
                            <default>400</default>
                        </config>

                    </carousel.splideOptions.speed>
                    <carousel.splideOptions.easing>

                        <label>Transition easing</label>
                        <config>
                            <type>input</type>
                            <default>cubic-bezier(0.25, 1, 0.5, 1)</default>
                            <valuePicker>
                                <items>
                                    <numIndex index="0">
                                        <numIndex index="0">linear</numIndex>
                                        <numIndex index="1">linear</numIndex>
                                    </numIndex>
                                    <numIndex index="1">
                                        <numIndex index="0">ease</numIndex>
                                        <numIndex index="1">ease</numIndex>
                                    </numIndex>
                                    <numIndex index="2">
                                        <numIndex index="0">cubic-bezier(0.25, 1, 0.5, 1)</numIndex>
                                        <numIndex index="1">cubic-bezier(0.25, 1, 0.5, 1)</numIndex>
                                    </numIndex>
                                </items>
                            </valuePicker>
                        </config>

                    </carousel.splideOptions.easing>
                    <carousel.splideOptions.start>
                        <label>Starting slide index</label>
                        <config>
                            <type>number</type>
                            <default>0</default>
                            <range>
                                <lower>0</lower>
                            </range>
                        </config>
                    </carousel.splideOptions.start>
                </el>
            </ROOT>
        </general>
        <autoplay>
            <ROOT>

                <sheetTitle>Autoplay</sheetTitle>

                <type>array</type>
                <el>
                    <carousel.splideOptions.autoplay>

                        <label>Autoplay</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>

                    </carousel.splideOptions.autoplay>
                    <carousel.autoplayToggle>

                        <label>Autoplay toggle button</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>

                    </carousel.autoplayToggle>
                    <carousel.splideOptions.pauseOnHover>
                        <label>Pause on hover</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </carousel.splideOptions.pauseOnHover>
                    <carousel.splideOptions.interval>
                        <label>Autoplay interval (in milliseconds)</label>
                        <config>
                            <type>input</type>
                            <eval>int</eval>
                            <default>1500</default>
                        </config>

                    </carousel.splideOptions.interval>
                </el>
            </ROOT>
        </autoplay>
    </sheets>
</T3DataStructure>