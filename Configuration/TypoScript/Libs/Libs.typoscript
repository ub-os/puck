@import 'EXT:puck/Configuration/_Libs/_*.typoscript'

lib.currentYear = COA
lib.currentYear {
    10 = TEXT
    10 {
        data = date:U
        strftime = %Y
        wrap = &nbsp;|&nbsp;
    }
}

lib.rootpid = TEXT
lib.rootpid.data = leveluid : 0

lib.pagetitle = TEXT
lib.pagetitle.data = page : title

lib.language = TEXT
lib.language.data = sitelanguage:twoLetterIsoCode

lib.contentElement {
    templateRootPaths.200 = EXT:puck/Resources/Private/Templates/Content/
    partialRootPaths.200 = EXT:puck/Resources/Private/Templates/Content/Partials/
    layoutRootPaths.200 = EXT:puck/Resources/Private/Templates/Content/Layouts/
    settings {
        media {
            additionalConfig {
                no-cookie = 1
                modestbranding = 1
                relatedVideos = 0
                showinfo = 0
                loop = 1
            }
        }
    }
}

lib.contentElementRenderer = RECORDS
lib.contentElementRenderer {
    tables = tt_content
    source.current = 1
    dontCheckPid = 1
}

lib.inlineSvg = SVG
lib.inlineSvg {
    renderMode = inline
    src.field = src
}
