// Content Wizard Groups
mod.wizards.newContentElement.wizardItems {
    01_content {
        header = Content
        before = plugins
        after = 00_presets
    }

    02_menu {
        header = Menus
        before = plugins
        after = 01_content
    }

    forms.before = plugins
    forms.elements.powermail_pi1 < mod.wizards.newContentElement.wizardItems.ext-powermail.elements.powermail-form
    forms.show = powermail_pi1, felogin_login, search, form_formframework
    ext-powermail.show =
    menu.show =
    common.show =
}

// Page Backend Layouts
defaultAllowedContent (
list, shortcut, html, puck_text, puck_media, puck_card, puck_container, puck_row_container, puck_section_carousel, puck_row, puck_columns, puck_cover_media, puck_hero, puck_page_menu, puck_anchor, puck_anchor_menu, puck_file_menu, powermail_pi1, shape_form, shape_consent
)
mod.web_layout.BackendLayouts {
    // layout with key "default" needs to be defined!
    default {
        title = Default
        config {
            backend_layout {
                colCount = 8
                rowCount = 2
                rows {
                    1 {
                        columns {
                            1 {
                                colPos = 1
                                identifier = main
                                name = Main content
                                colspan = 8
                                allowed.CType < defaultAllowedContent
                            }
                        }
                    }

                    3 {
                        columns {
                            1 {
                                colPos = 9
                                identifier = modals
                                name = Modals
                                colspan = 8
                                allowed.CType = puck_modal
                            }
                        }
                    }
                }
            }
        }
    }

    error {
        title = Error
        config {
            backend_layout {
                rows {
                    1 {
                        columns {
                            1 {
                                colPos = 1
                                identifier = main
                                name = Error content
                                colspan = 8
                                allowed.CType = puck_error_text
                            }
                        }
                    }
                }
            }
        }
    }

    folder {
        title = Folder
        config.backend_layout {
            rows {
                1 {
                    columns {
                        1 {
                            colPos = 1
                            name = Folder
                            colSpan = 8
                        }
                    }
                }
            }
        }
    }

    sysfolder {
        title = System Folder
        config.backend_layout {
            rows {
                1 {
                    columns {
                        1 {
                            colPos = 10000
                            name = Navigations
                            colSpan = 8
                            allowed.CType = puck_sys_navigation
                        }
                    }
                }
                2 {
                    columns {
                        1 {
                            colPos = 1
                            name = System Elements
                            colSpan = 8
                            allowed.CType < defaultAllowedContent
                        }
                    }
                }
                3 {
                    columns {
                        1 {
                            colPos = 699
                            name = System Elements (inner child content)
                            colSpan = 8
                            allowed.CType < defaultAllowedContent
                        }
                    }
                }
            }
        }
    }

    detail-plugin {
        title = Plugin detail page
        config.backend_layout {
            colCount = 8
            rows {
                1 {
                    columns {
                        1 {
                            colPos = 1
                            identifier = main
                            name = Main content
                            colSpan = 8
                            allowed.CType = list
                        }
                    }
                }
            }
        }
    }
}

// map allowed backend layouts to doktypes
TCEFORM.pages.backend_layout.itemsProcFunc.doktypes {
    // only allow backendLayout "default" on pages with doktype 1
    1 = default, error
    254 = folder, sysfolder
    16503 = default
}

TCEFORM.tt_content.tx_container_parent.disabled = 1