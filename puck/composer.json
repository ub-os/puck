{
  "name": "ubos/puck",
  "type": "typo3-cms-extension",
  "description": "UBOS Puck",
  "license": "GPL-2.0-or-later",
  "version": "1.0.0",
  "require": {
    "php": "8.0",
    "typo3/cms-core": "^11",
    "typo3/cms-lowlevel": "^11",
    "typo3/cms-redirects": "^11",
    "ichhabrecht/content-defender": "^3.2",
    "sitegeist/fluid-components": "^3.4",
    "lochmueller/autoloader": "^7.4",
    "brotkrueml/schema": "^2.6",
    "plan2net/webp": "^4.2",
    "b13/menus": "^1.0",
    "eliashaeussler/typo3-warming": "^0",
    "phpoffice/phpspreadsheet": "^1.27",
    "georgringer/numbered-pagination": "^1.0"
  },
  "replace": {
    "typo3-ter/puck": "self.version"
  },
  "autoload": {
    "psr-4": {
      "UBOS\\Puck\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "puck"
    }
  }
}