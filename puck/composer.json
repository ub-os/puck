{
  "name": "ubos/puck",
  "type": "typo3-cms-extension",
  "description": "Puck",
  "license": "GPL-2.0-or-later",
  "version": "1.0.0",
  "requiresNotReadyForV13": {
    "christophlehmann/pagetreefilter": "^2",
    "oliveoilexpert/puck-powermail": "*",
    "kitzberger/doktype-typolink": "^3",
    "b13/slash-force": "^1.0",
    "t3/scroll": "^2",
    "ichhabrecht/content-defender": "*"
  },
  "require": {
    "php": "^8",
    "phpoffice/phpspreadsheet": "^1.27",
    "typo3/cms-core": "^12 || ^13",
    "typo3/cms-lowlevel": "^12 || ^13",
    "typo3/cms-redirects": "^12 || ^13",
    "typo3/cms-recycler": "^12 || ^13",
    "sitegeist/fluid-components": "*",
    "eliashaeussler/typo3-warming": "^3",
    "brotkrueml/schema": "^3",
    "b13/container": "^3",
    "oliveoilexpert/puckloader": "dev-main",
    "oliveoilexpert/content-presets": "*",
    "oliveoilexpert/ckeditor-icons": "^0.2",
    "b13/menus": "dev-main",
    "wapplersystems/avif": "^12.0"
  },
  "replace": {
    "typo3-ter/puck": "self.version"
  },
  "autoload": {
    "psr-4": {
      "UBOS\\Puck\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "puck"
    }
  }
}