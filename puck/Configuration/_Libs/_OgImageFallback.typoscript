lib.ogImageFallback = FLUIDTEMPLATE
lib.ogImageFallback {
    templateRootPaths.900 = EXT:puck/Resources/Private/Fluid/Libs/
    templateName = OgImageFallback
    dataProcessing {
        10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        10 {
            references.fieldName = media
        }
        20 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        20 {
            references.fieldName = logo
            as = logos
        }
    }
}