config.tx_fluidcomponents.settings {
    namespaces {
        ubos = UBOS\Puck\ViewHelpers
    }

    search {
        pid = {$search.pid}
    }

    navUid {
        main = {$navUid.main}
        footer = {$navUid.footer}
        social = {$navUid.social}
        meta = {$navUid.meta}
    }

    doktype {
        start = {$doktype.start}
        overview = {$doktype.overview}
        news = {$doktype.news}
        person = {$doktype.person}
        detailPlugin = {$doktype.detailPlugin}
    }

    gridWidth = {$gridWidth}
    rootLayout = {$rootLayout}
    favicon = {$favicon}
    logo = {$logo}
}


