plugin.tx_seo {
    config {
        xmlSitemap {
            sitemaps {
                pages {
                    config {
                        excludedDoktypes = 3, 4, 6, 7, 199, 254, 255, 16503
                    }
                }
                news {
                    provider = TYPO3\CMS\Seo\XmlSitemap\PagesXmlSitemapDataProvider
                    config {
                        excludedDoktypes = 1, 3, 4, 6, 7, 199, 254, 255
                        additionalWhere = {#no_index} = 0 AND {#canonical_link} = ''
                        excludePagesRecursive =
                    }
                }
            }
        }
    }
}