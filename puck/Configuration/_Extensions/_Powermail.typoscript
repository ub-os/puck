plugin.tx_powermail {
    view {
        templateRootPaths {
            100 = EXT:puck/Resources/Private/Fluid/Extensions/Powermail/Templates
        }
        partialRootPaths {
            100 = EXT:puck/Resources/Private/Fluid/Extensions/Powermail/Partials
        }
    }
    settings {
        javascript {
            addJQueryFromGoogle = 0
            addAdditionalJavaScript = 0
            powermailJQuery >
        }
        setup.validation.client = 0
        setup.spamshield._enable = 1
        setup.misc.htmlForHtmlFields = 1
        setup.main.optin = 0
        setup.db.enable = 0
        setup.sender {
            enable = 0
            default.senderName = Typo3 Website
            default.senderEmail =
            overwrite.senderEmail =
            subject = Powermail default subject for user mail
        }
        setup.receiver {
            enable = 0
            default.senderName = Typo3 Website
            default.senderEmail =
            overwrite.senderEmail =
            subject = Powermail default subject for receiver mail
        }
        setup.optin {
            subject = Bitte bestätigen Sie Ihre E-Mail-Adresse
        }
    }
}

page.includeJSFooter {
    powermailForm >
}
