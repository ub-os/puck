plugin.tx_powermail {
    view {
        templateRootPaths {
            200 = EXT:puck/Resources/Private/Fluid/Extensions/Powermail/Templates
        }
        partialRootPaths {
            200 = EXT:puck/Resources/Private/Fluid/Extensions/Powermail/Partials
        }
    }
    settings {
        javascript {
            addJQueryFromGoogle = 0
            addAdditionalJavaScript = 0
            powermailJQuery >
        }
    }
}

page.includeJSFooter {
    powermailForm >
}
