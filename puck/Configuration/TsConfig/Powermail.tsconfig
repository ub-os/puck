tx_powermail.flexForm.addField.settings\.flexform\.thx\.body {
    _sheet = thx
    label = Text on submit page
    config {
        type = text
        cols = 40
        rows = 15
        enableRichtext = 1
        richtextConfiguration = puck_default
    }
}

tx_powermail.flexForm.type.addFieldOptions.navigation = Form Step Control
tx_powermail.flexForm.type.addFieldOptions.navigation.export = 0
