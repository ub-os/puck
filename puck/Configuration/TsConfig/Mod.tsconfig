// Content Wizard Groups
mod.wizards.newContentElement.wizardItems {
    01_content {
        header = Content
        before = plugins
        after = 00_presets
    }

    02_menu {
        header = Menus
        before = plugins
        after = 01_content
    }

    forms.before = plugins
    forms.elements.powermail_pi1 < mod.wizards.newContentElement.wizardItems.ext-powermail.elements.powermail-form
    forms.show = powermail_pi1, felogin_login, search, form_formframework
    ext-powermail.show =
    menu.show =
    common.show =
}

// Page Backend Layouts
defaultAllowedContent (
list, shortcut, html, puck_text, puck_media, puck_container, puck_row_container, puck_section_carousel, puck_row, puck_columns, puck_cover_media, puck_hero, puck_page_menu, puck_anchor, puck_anchor_menu, puck_file_menu, powermail_pi1, puck_formal_form, form_formframework
)
mod.web_layout.BackendLayouts {
    // layout with key "default" needs to be defined!
    default {
        title = Default
        config {
            backend_layout {
                colCount = 8
                rowCount = 2
                rows {
                    1 {
                        columns {
                            1 {
                                name = Main content
                                colPos = 1
                                colspan = 8
                                allowed.CType < defaultAllowedContent
                            }
                        }
                    }

                    3 {
                        columns {
                            1 {
                                name = Modals
                                colPos = 9
                                colspan = 8
                                allowed.CType = puck_modal
                            }
                        }
                    }
                }
            }
        }
    }

    error {
        title = Error
        config {
            backend_layout {
                rows {
                    1 {
                        columns {
                            1 {
                                name = Error content
                                colPos = 1
                                colspan = 8
                                allowed.CType = puck_error_text
                            }
                        }
                    }
                }
            }
        }
    }

    folder {
        title = Folder
        config.backend_layout {
            rows {
                1 {
                    columns {
                        1 {
                            name = Folder
                            colPos = 1
                            colSpan = 8
                        }
                    }
                }
            }
        }
    }

    detail-plugin {
        title = Plugin detail page
        config.backend_layout {
            colCount = 8
            rows {
                1 {
                    columns {
                        1 {
                            name = Main content
                            colPos = 1
                            colSpan = 8
                            allowed.CType = list
                        }
                    }
                }
            }
        }
    }
}

// map allowed backend layouts to doktypes
TCEFORM.pages.backend_layout.itemsProcFunc.doktypes {
    // only allow backendLayout "default" on pages with doktype 1
    1 = default, error
    254 = folder
    16503 = default
    16511 = detail-plugin
}