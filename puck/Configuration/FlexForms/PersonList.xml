<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Selection</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.parents>
                        <TCEforms>
                            <label>Parents</label>
                            <config>
                                <type>group</type>
                                <internal_type>db</internal_type>
                                <allowed>pages</allowed>
                                <size>3</size>
                                <maxitems>50</maxitems>
                                <minitems>0</minitems>
                            </config>
                        </TCEforms>
                    </settings.parents>
                    <settings.persons>
                        <TCEforms>
                            <label>Persons</label>
                            <config>
                                <type>group</type>
                                <internal_type>db</internal_type>
                                <allowed>tx_puck_domain_model_person</allowed>
                                <size>10</size>
                                <maxitems>100</maxitems>
                                <minitems>0</minitems>
                            </config>
                        </TCEforms>
                    </settings.persons>
                </el>
            </ROOT>
        </sDEF>
        <demand>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Demand settings</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.demand.team>
                        <TCEforms>
                            <label>Only show team members</label>
                            <config>
                                <type>check</type>
                            </config>
                        </TCEforms>
                    </settings.demand.team>
                    <settings.demand.limit>
                        <TCEforms>
                            <label>Maximum number of posts displayed</label>
                            <config>
                                <type>input</type>
                                <eval>num</eval>
                                <size>2</size>
                            </config>
                        </TCEforms>
                    </settings.demand.limit>
                    <settings.demand.offset>
                        <TCEforms>
                            <label>Number of posts to skip before displaying the first post</label>
                            <config>
                                <type>input</type>
                                <eval>num</eval>
                                <size>2</size>
                            </config>
                        </TCEforms>
                    </settings.demand.offset>
                </el>
            </ROOT>
        </demand>
        <order>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Order</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.order.field>
                        <TCEforms>
                            <label>Order by</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items>
                                    <numIndex index="0">
                                        <numIndex index="0">Record sorting</numIndex>
                                        <numIndex index="1">sorting</numIndex>
                                    </numIndex>
                                    <numIndex index="1">
                                        <numIndex index="0">Name</numIndex>
                                        <numIndex index="1">name</numIndex>
                                    </numIndex>
                                    <numIndex index="3">
                                        <numIndex index="0">Position</numIndex>
                                        <numIndex index="1">position</numIndex>
                                    </numIndex>
                                </items>
                            </config>
                        </TCEforms>
                    </settings.order.field>
                    <settings.order.direction>
                        <TCEforms>
                            <label>Order Direction</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items>
                                    <numIndex index="0">
                                        <numIndex index="0">Descending</numIndex>
                                        <numIndex index="1">desc</numIndex>
                                    </numIndex>
                                    <numIndex index="1">
                                        <numIndex index="0">Ascending</numIndex>
                                        <numIndex index="1">asc</numIndex>
                                    </numIndex>
                                </items>
                            </config>
                        </TCEforms>
                    </settings.order.direction>
                </el>
            </ROOT>
        </order>

        <pagination>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Pagination</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.pagination.active>
                        <TCEforms>
                            <label>Pagination</label>
                            <config>
                                <type>check</type>
                                <renderType>checkboxToggle</renderType>
                                <default>1</default>
                            </config>
                        </TCEforms>
                    </settings.pagination.active>
                    <settings.pagination.itemsPerPage>
                        <TCEforms>
                            <label>Items per page</label>
                            <config>
                                <type>input</type>
                                <eval>num</eval>
                                <size>2</size>
                                <default>12</default>
                            </config>
                        </TCEforms>
                    </settings.pagination.itemsPerPage>
                </el>
            </ROOT>
        </pagination>
        <template>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Template</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.template.layout>
                        <TCEforms>
                            <label>Layout</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items>
                                    <numIndex index="0">
                                        <numIndex index="0">Team cards</numIndex>
                                        <numIndex index="1">team-cards</numIndex>
                                    </numIndex>
                                </items>
                            </config>
                        </TCEforms>
                    </settings.template.layout>
                </el>
            </ROOT>
        </template>

    </sheets>
</T3DataStructure>