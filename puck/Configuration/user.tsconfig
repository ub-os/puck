options {
    clearCache.all = 1
    clearCache.pages = 1
    clearCache.system = 1
    pageTree {
        showPageIdWithTitle = 0
        showDomainNameWithTitle = 1
        // exclude news from tree
        excludeDoktypes = 16503
        // add doktypes to the new page drag area
        doktypesToShowInNewPageDragArea := addToList()
    }
}

admPanel.hide = 1