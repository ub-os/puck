page.20 = USER
page.20 {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = Puck
    pluginName = Page
    vendorName = UBOS
    settings {
        view {
            templateRootPath = EXT:puck/Resources/Private/Fluid/
        }
        navigations {
            main {
                uid = 1
            }
        }

    }
}

pageMenuPlugin = PAGE
pageMenuPlugin {
    typeNum = 16500000
    20 = USER
    20 {
        userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
        extensionName = Puck
        vendorName = UBOS
        pluginName = PageMenu
        settings {
            extensionKey = Puck
            vendorName = UBOS
        }
    }
    config {
        disableAllHeaderCode = 1
        debug = 0
        admPanel = 0
    }
}
newsMenuPlugin < pageMenuPlugin
newsMenuPlugin.typeNum = 16500001
newsMenuPlugin.20.pluginName = NewsMenu

personMenuPlugin < pageMenuPlugin
