page = PAGE
page.5 >
page.1 = TEXT

## css & js
page.includeCSS {
    puck = EXT:puck/Resources/Public/Css/dist/puck.min.css
}
page.includeJS {
    puck = EXT:puck/Resources/Public/JavaScript/dist/puck.min.js
    puck.defer = 1
    puck.async = 1
}
page.includeJSFooter {
    puck-body = EXT:puck/Resources/Public/JavaScript/dist/puck-body.min.js
    puck-body.defer = 1
    puck-body.async = 1
}
[applicationContext == "Development"]
    page.includeCSS.puck = EXT:puck/Resources/Public/Css/dist/puck.css
    page.includeJS.puck = EXT:puck/Resources/Public/JavaScript/dist/puck.js
    page.includeJSFooter.puck-body = EXT:puck/Resources/Public/JavaScript/dist/puck-body.js
[END]

## Meta
page.meta {
    X-UA-Compatible = IE=edge
    X-UA-Compatible.attribute = http-equiv
    viewport = width=device-width,initial-scale=1.0
    robots = index,follow
    description.data = DB:pages:1:description
    description.override.field = description
    keywords.field = keywords
    twitter:card = summary
    og:type = Website
    og:site_name.data = site:websiteTitle
    og:title.field = seo_title
    og:description.field = description
}

page.bodyTagAdd = id="body"

[traverse(page, "og_title")]
    page.meta.og:title.field = og_title
[end]
[traverse(page, "og_description")]
    page.meta.og:description.field = og_description
[end]
[!traverse(page, "og_image")]
    page.headerData.40 < lib.ogImageFallback
[end]

page.shortcutIcon = EXT:puck/Resources/Public/Icons/Favicons/favicon.ico

page.headerData.110 = TEXT
page.headerData.110.value (
)

page.headerData.120 = TEXT
page.headerData.120.value (
)
