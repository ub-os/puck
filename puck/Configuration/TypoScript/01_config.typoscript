typeNum = 0
config {
    headerComment (
    )
    disableImgBorderAttr = 1
    pageTitleFirst = 1
    pageTitleSeparator = -
    pageTitleSeparator.noTrimWrap = | | |
    absRefPrefix = /
    prefixLocalAnchors = all
    disablePrefixComment = 1
    removeDefaultJS = external
    inlineStyle2TempFile = 1s
    spamProtectEmailAddresses = 2
    spamProtectEmailAddresses_atSubst = <span>&#064;</span>
    spamProtectEmailAddresses_lastDotSubst = <span>&#046;</span>
    cache_clearAtMidnight = 1
    sendCacheHeaders = 1
    enableContentLengthHeader = 1
    sendCacheHeaders_onlyWhenLoginDeniedInBranch = 0
    htmlTag.attributes {
        id = document
    }
    uniqueLinkVars = 1
    linkVars = L(int)
    sys_language_uid = 0
    doctype = html5
    xmlprologue = none
    admPanel = 1
    contentObjectExceptionHandler = 0
    no_cache = 0
    compressCss = 1
    compressJs = 1
    showWebsiteTitle = 0
    pageTitleProviders {
        puck {
            provider = UBOS\Puck\PageTitle\PuckTitleProvider
            before = seo
        }
    }
}


[applicationContext == "Development"]
    config.compressCss = 0
    config.compressJs = 0
[END]

[applicationContext == "Development" && backend.user.isLoggedIn]
    config.no_cache = 1
[global]


// force absolute URLs in Typolinks
// parseFunc
lib.parseFunc.tags.a.typolink.forceAbsoluteUrl = 1
lib.parseFunc.tags.link.typolink.forceAbsoluteUrl = 1
lib.parseFunc.tags.a.typolink.forceAbsoluteUrl.scheme = https
lib.parseFunc.tags.link.typolink.forceAbsoluteUrl.scheme = https

// parseFunc_RTE
lib.parseFunc_RTE.tags.a.typolink.forceAbsoluteUrl = 1
lib.parseFunc_RTE.tags.link.typolink.forceAbsoluteUrl = 1
lib.parseFunc_RTE.tags.a.typolink.forceAbsoluteUrl.scheme = https
lib.parseFunc_RTE.tags.link.typolink.forceAbsoluteUrl.scheme = https

lib.parseFunc_RTE.externalBlocks.table.stdWrap.HTMLparser.tags.table.fixAttrib.class.list =
