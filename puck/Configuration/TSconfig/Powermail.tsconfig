tx_powermail.flexForm.addField.settings\.flexform\.db\.enable {
    _sheet = main
    label = Store Mails in database
    config {
        type = check
    }
}

tx_powermail.flexForm.addField.settings\.flexform\.thx\.body {
    _sheet = thx
    label = Text on submit page
    config {
        type = text
        cols = 40
        rows = 15
        enableRichtext = 1
        richtextConfiguration = puck_default
    }
}