

// Content Wizard Groups
mod.wizards.newContentElement.wizardItems {
    01_content {
        header = Content
    }
    03_menu {
        header = Menu
    }
    03_presets {
        header = Presets
        elements {
            preset_puck_media_contact {
                iconIdentifier = tcarecords-tt_content-puck_media
                title = Text and media: Contact
                description = Text and media preset for contact element.
                tt_content_defValues {
                    CType = puck_media
                    container_width = 10
                    text_column_width = 6
                    media_column_width = 3
                    item_column_width = 3
                    row_justify = space-between
                    media_layout = left
                    header = Contact
                }
            }
        }
        show := addToList(preset_puck_media_contact)
    }
    menu.show =
    common.show =
    forms.show =
}

// Page Backend Layouts
allowedContent = puck_menu_persons, puck_menu_posts, puck_page_list, puck_container, puck_row, list, shortcut, html, puck_accordions, puck_anchor, puck_cards, puck_columns, puck_full_width_media, puck_media, puck_menu_anchors, puck_menu_pages, puck_hero, puck_hero_carousel, puck_text, puck_menu_files
backendLayoutDefaultConfig {
    backend_layout {
        colCount = 8
        rowCount = 2
        rows {
            1 {
                columns {
                    1 {
                        name = Main content
                        colPos = 1
                        colspan = 8
                        allowed.CType < allowedContent
                    }
                }
            }
#            2 {
#                columns {
#                    1 {
#                        name = Footer
#                        colPos = 3
#                        colspan = 8
#                        allowed.CType = puck_text
#
#
#                    }
#                }
#            }
            3 {
                columns {
                    1 {
                        name = Modals
                        colPos = 9
                        colspan = 8
                        allowed.CType = puck_modal
                    }
                }
            }
        }
    }
}

mod.web_layout.BackendLayouts {
    default {
        title = Default
        config < backendLayoutDefaultConfig
        config.backend_layout.doktype = 1
    }
    start {
        title = Start
        config < backendLayoutDefaultConfig
        config.backend_layout.doktype = {$doktype.start}
    }
    overview {
        title = Overview
        config < backendLayoutDefaultConfig
        config.backend_layout.doktype = {$doktype.overview}
    }
    post {
        title = Post
        config < backendLayoutDefaultConfig
        config.backend_layout.doktype = {$doktype.post}
    }
    person {
        title = Person page
        config < backendLayoutDefaultConfig
        config.backend_layout.doktype = {$doktype.person}
    }
    detail-plugin {
        title = Plugin detail page
        config.backend_layout {
            doktype = {$doktype.detailPlugin}
            colCount = 8
            rows {
                1 {
                    columns {
                        1 {
                            name = Main content
                            colPos = 1
                            colSpan = 8
                            allowed.CType = list
                        }
                    }
                }
            }
        }
    }
}
