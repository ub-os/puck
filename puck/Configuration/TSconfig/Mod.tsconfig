}
// Page Backend Layouts
allowedContent = list, shortcut, html, puck_accordions, puck_anchor, puck_cards, puck_columns, puck_full_width_media, puck_media, puck_menu_anchors, puck_menu_pages, puck_hero, puck_hero_carousel, puck_text
mod.web_layout.BackendLayouts {
    home {
        title = Home
        config {
            backend_layout {
                colCount = 8
                rowCount = 2
                rows {
                    1 {
                        columns {
                            1 {
                                name = Main content
                                colPos = 1
                                colspan = 8
                                allowed {
                                    CType < allowedContent
                                }
                            }
                        }
                    }
                    2 {
                        columns {
                            1 {
                                name = Footer
                                colPos = 3
                                colspan = 8
                                allowed {
                                    CType = puck_text
                                }
                            }
                        }
                    }
                    3 {
                        columns {
                            1 {
                                name = Modals
                                colPos = 9
                                colspan = 8
                                allowed {
                                    CType = puck_modal
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    default {
        title = Default
        config {
            backend_layout {
                colCount = 8
                rowCount = 2
                rows {
                    1 {
                        columns {
                            1 {
                                name = Main content
                                colPos = 1
                                colspan = 8
                                allowed {
                                    CType < allowedContent
                                }
                            }
                        }
                    }
                    2 {
                        columns {
                            1 {
                                name = Footer
                                colPos = 3
                                colspan = 8
                                allowed {
                                    CType = puck_text
                                }
                            }
                        }
                    }
                    3 {
                        columns {
                            1 {
                                name = Modals
                                colPos = 9
                                colspan = 8
                                allowed {
                                    CType = puck_modal
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    plugin-detail {
        title = Plugin detail page
        config {
            backend_layout {
                colCount = 8
                rows {
                    1 {
                        columns {
                            1 {
                                name = Main content
                                colPos = 1
                                colSpan = 8
                                allowed {
                                    CType = list
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}