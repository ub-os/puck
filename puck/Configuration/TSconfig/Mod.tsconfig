// Content Wizard Groups
mod.wizards.newContentElement.wizardItems {
    menu.show =
    common.show =
    forms.show =
}

// Page Backend Layouts
defaultAllowedContent (
list, shortcut, html, puck_text, puck_media, puck_container, puck_row, puck_cards, puck_columns, puck_accordions, puck_full_width_media, puck_hero, puck_hero_carousel, puck_menu_pages, puck_anchor, puck_menu_anchors, puck_menu_files
)
mod.web_layout.BackendLayouts {
    // layout with key "default" needs to be defined!
    default {
        title = Default
        config {
            backend_layout {
                colCount = 8
                rowCount = 2
                test =
                rows {
                    1 {
                        columns {
                            1 {
                                name = Main content
                                colPos = 1
                                colspan = 8
                                allowed.CType < defaultAllowedContent
                            }
                        }
                    }
                    3 {
                        columns {
                            1 {
                                name = Modals
                                colPos = 9
                                colspan = 8
                                allowed.CType = puck_modal
                            }
                        }
                    }
                }
            }
        }
    }
    detail-plugin {
        title = Plugin detail page
        config.backend_layout {
            doktype = {$doktype.detailPlugin}
            colCount = 8
            rows {
                1 {
                    columns {
                        1 {
                            name = Main content
                            colPos = 1
                            colSpan = 8
                            allowed.CType = list
                        }
                    }
                }
            }
        }
    }
}

// map allowed backend layouts to doktypes
TCEFORM.pages.backend_layout.itemsProcFunc.doktypes {
    // only allow backendLayout "default" on pages with doktype 1
    1 = default
    16503 = default
    16511 = detail-plugin
}