@use 'sass:map';

@font-face {
    font-family: "{{ name }}";
    src: {{{ fontSrc }}};
}

{{# if selector }}
{{ selector }} {
{{ else }}
{{ tag }}[class^="{{prefix}}-"], {{ tag }}[class*=" {{prefix}}-"] {
{{/ if }}
    font-family: {{ name }} !important;
    font-style: normal;
    font-weight: normal !important;
    font-variant: normal;
    text-transform: none;
    line-height: 1;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

:root {
{{# each codepoints }}
    --icon-code-{{ @key }}: "\\{{ codepoint this }}";
{{/ each }}
}

{{# each codepoints }}
{{# if ../selector }}
{{ ../selector }}.{{ ../prefix }}-{{ @key }}:before {
{{ else }}
{{ tag }}.{{ ../prefix }}-{{ @key }}:before {
{{/ if }}
    content: var(--icon-code-{{ @key }});
}
{{/ each }}