{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": { "ignoreUnknown": false, "ignore": [] },
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"useGenericFontNames": "off"
			},
			"complexity": {
				"noForEach": "off",
				"noStaticOnlyClass": "off",
				"noThisInStatic": "off"
			},
			"suspicious": {
				"noAssignInExpressions": "off",
				"noDoubleEquals": "off"
			},
			"style": {
				"useSingleVarDeclarator": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"lineWidth": 200,
			"semicolons": "asNeeded",
			"quoteStyle": "single",
			"arrowParentheses": "asNeeded"
		}
	}
}
