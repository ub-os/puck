{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": { "ignoreUnknown": false, "includes": ["**"] },
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"useGenericFontNames": "off",
                "useHtmlLang": "off",
                "noLabelWithoutControl": "off",
                "useAnchorContent": "off",
                "noSvgWithoutTitle": "off"
			},
			"complexity": {
				"noForEach": "off",
				"noStaticOnlyClass": "off",
				"noThisInStatic": "off"
			},
			"suspicious": {
				"noAssignInExpressions": "off",
				"noDoubleEquals": "off"
			},
			"style": {
				"useSingleVarDeclarator": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"lineWidth": 120,
			"semicolons": "asNeeded",
			"quoteStyle": "single",
			"arrowParentheses": "asNeeded"
		}
	}
}
