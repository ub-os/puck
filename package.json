{
  "name": "t3init",
  "version": "1.0.0",
  "description": "UBOS TYPO3 Theme",
  "config": {
    "path": {
      "src": "theme/Resources/Private/",
      "dist": "theme/Resources/Public/"
    }
  },
  "scripts": {
    "watch": "run-p watch:js watch:css",
    "watch:dev": "run-p watch:js:dev watch:css:dev",
    "build": "run-s createDist build:js build:css build:icons build:ctype:configs",
    "build:dev": "run-s createDist build:js:dev build:css:dev build:icons build:ctype:configs",
    "build:icons": "run-s build:fantasticon build:sprite-sheet build:favicons && node build/icons.js",
    "build:ctype:configs": "node build/ctype-configs.js",
    "build:ctype:new": "node build/ctype-new.js",
    "watch:js": "onchange 'theme/Resources/Private/JavaScript/**/*.js' -- run-s build:js",
    "watch:css": "onchange 'theme/Resources/Private/Stylesheets/**/*.s*ss' -- run-s build:css",
    "watch:js:dev": "onchange 'theme/Resources/Private/JavaScript/**/*.js' -- run-s build:js:dev",
    "watch:css:dev": "onchange 'theme/Resources/Private/Stylesheets/**/*.s*ss' -- run-s build:css:dev",
    "build:js": "run-s build:js:dev uglify",
    "build:css": "run-s build:css:dev minifycss",
    "build:js:dev": "run-s jshint browserify",
    "build:css:dev": "run-s dart-sass autoprefixer",
    "build:favicons": "node build/favicons.js",
    "build:xlf-to-json": "node build/xlf-to-json.js",
    "build:fantasticon": "node build/fantasticon.js",
    "build:sprite-sheet": "node build/sprite-sheet.js",
    "dart-sass": "node build/dart-sass.js",
    "createDist": "mkdir -p ${npm_package_config_path_dist}js && mkdir -p ${npm_package_config_path_dist}css",
    "jshint": "jshint ${npm_package_config_path_src}JavaScript/**/*.js",
    "browserify": "browserify -t [ babelify --presets [ @babel/preset-env ] ] -d ${npm_package_config_path_src}JavaScript/app.js > ${npm_package_config_path_dist}js/app.js",
    "uglify": "uglifyjs ${npm_package_config_path_dist}js/app.js --compress --mangle -o ${npm_package_config_path_dist}js/app.min.js",
    "node-sass": "node-sass --importer node_modules/node-sass-glob-importer/dist/cli.js -o ${npm_package_config_path_dist}css ${npm_package_config_path_src}Stylesheets --source-map true",
    "autoprefixer": "postcss ${npm_package_config_path_dist}css/styles.css --use autoprefixer --map -o ${npm_package_config_path_dist}css/styles.css",
    "minifycss": "css-minify -d ${npm_package_config_path_dist}css -o ${npm_package_config_path_dist}css"
  },
  "devDependencies": {
    "@babel/core": "^7.12.13",
    "@babel/preset-env": "^7.12.13",
    "autoprefixer": "^8.6.5",
    "babelify": "^10.0.0",
    "browserify": "^17.0.0",
    "css-minify": "^2.0.0",
    "fantasticon": "^1.2.3",
    "favicons": "^7.0.0-beta.4",
    "install": "^0.13.0",
    "jshint": "^2.13.1",
    "matchdep": "*",
    "node-sass-glob-importer": "^5.3.2",
    "npm": "^7.21.1",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "postcss": "^8.3.6",
    "postcss-cli": "^8.3.1",
    "sass": "^1.49.7",
    "svgstore": "^3.0.1",
    "uglify-js": "^3.14.1",
    "xliff": "^6.0.1"
  },
  "dependencies": {
    "@glidejs/glide": "^3.4.1",
    "normalize.css": "^8.0.1",
    "rfs": "^9.0.6",
    "smoothscroll-polyfill": "^0.4.4"
  },
  "browserslist": [
    "defaults"
  ]
}
