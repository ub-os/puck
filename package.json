{
	"name": "puck",
	"version": "1.0.0",
	"description": "Puck",
	"type": "module",
	"config": {
		"path": {
			"src": "puck/Resources/Private/",
			"dist": "puck/Resources/Public/"
		}
	},
	"engines": {
		"npm": ">=10",
		"node": ">=22"
	},
	"scripts": {
		"watch": "run-p watch:js watch:css watch:frontend-icons watch:favicons",
		"build": "run-s build:frontend-icons build:favicons build:js build:css",
		"biome:check": "biome check",
		"biome:fix": "biome check --write",
		"build:js": "node build-scripts/esbuild.js",
		"build:css": "run-s sass autoprefixer minifycss",
		"build:frontend-icons": "node build-scripts/fantasticon.js && node build-scripts/svgstore.js",
		"build:favicons": "node build-scripts/favicons.js",
		"watch:js": "onchange 'puck/Resources/Private/JavaScript/**/*.js*' -- run-s build:js",
		"watch:css": "onchange 'puck/Resources/Private/Stylesheets/**/*.s*ss' -- run-s build:css",
		"watch:frontend-icons": "onchange 'puck/Resources/Public/Icons/Frontend/*.svg' -- run-s build:fantasticon build:sprite-sheet && node build-scripts/icons.js",
		"watch:favicons": "onchange 'puck/Resources/Public/Icons/Favicons/*.svg' -- run-s build:favicons",
		"sass": "node build-scripts/sass.js",
		"autoprefixer": "postcss ${npm_package_config_path_dist}Css/dist/puck.css --use autoprefixer --map -o ${npm_package_config_path_dist}Css/dist/puck.css",
		"minifycss": "css-minify -d ${npm_package_config_path_dist}Css/dist -o ${npm_package_config_path_dist}Css/dist"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"autoprefixer": "^10.4.21",
		"chalk": "^5.4.1",
		"css-minify": "^2.0.2",
		"esbuild": "^0.25.2",
		"fantasticon": "^3.0.0",
		"favicons": "^7.2.0",
		"glob": "^11.0.0",
		"install": "^0.13.0",
		"matchdep": "*",
		"npm-run-all": "^4.1.5",
		"onchange": "^7.1.0",
		"postcss": "^8.5.3",
		"postcss-cli": "^11.0.0",
		"sass": "^1.85.1",
		"svgstore": "^3.0.1"
	},
	"dependencies": {
		"@oliveoilexpert/stim": "^2",
		"@splidejs/splide": "^4.1.4",
		"@splidejs/splide-extension-intersection": "^0.2.0",
		"cssnano": "^7.0.6",
		"htmx-ext-head-support": "^2.0.2",
		"htmx-ext-preload": "^2.0.1",
		"htmx.org": "^2",
		"normalize.css": "^8.0.1",
		"plyr": "^3.7.8",
		"postcss-functions": "^4.0.2",
		"postcss-import": "^16.1.0",
		"postcss-import-ext-glob": "^2.1.1",
		"postcss-mixins": "^11.0.3",
		"postcss-nested": "^7.0.2",
		"postcss-preset-env": "^10.1.5",
		"postcss-simple-vars": "^7.0.1",
		"rfs": "^10.0.0"
	},
	"browserslist": [
		"defaults and fully supports es6-module"
	]
}
