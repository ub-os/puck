{
  "name": "t3init",
  "version": "1.0.0",
  "description": "ubos typo3 sitepackage",
  "type": "module",
  "config": {
    "path": {
      "src": "puck/Resources/Private/",
      "dist": "puck/Resources/Public/"
    }
  },
  "scripts": {
    "watch": "run-p watch:js watch:icons watch:css",
    "watch:dev": "run-p watch:js:dev watch:css:dev watch:icons",
    "build": "run-s createDist build:icons build:js build:css",
    "build:dev": "run-s createDist build:icons build:js:dev build:css:dev",
    "watch:js": "onchange 'puck/Resources/Private/JavaScript/**/*.js' -- run-s build:js",
    "watch:css": "onchange 'puck/Resources/Private/Stylesheets/**/*.s*ss' -- run-s build:css",
    "watch:js:dev": "onchange 'puck/Resources/Private/JavaScript/**/*.js' -- run-s build:js:dev",
    "watch:css:dev": "onchange 'puck/Resources/Private/Stylesheets/**/*.s*ss' -- run-s build:css:dev",
    "watch:icons": "run-p watch:frontend-icons watch:favicons",
    "watch:frontend-icons": "onchange 'puck/Resources/Public/Icons/Frontend/*.svg' -- run-s build:fantasticon build:sprite-sheet && node build/icons.js",
    "watch:favicons": "onchange 'puck/Resources/Public/Icons/Favicons/*.svg' -- run-s build:favicons",
    "build:js": "run-s build:js:dev uglify",
    "build:css": "run-s build:css:dev minifycss",
    "build:js:dev": "run-s eslint browserify",
    "build:css:dev": "run-s dart-sass autoprefixer",
    "build:icons": "run-s build:fantasticon build:sprite-sheet build:favicons && node build/icons.js",
    "build:favicons": "node build/favicons.js",
    "build:xlf-to-json": "node build/xlf-to-json.js",
    "build:fantasticon": "node build/fantasticon.js",
    "build:sprite-sheet": "node build/sprite-sheet.js",
    "build:content:new": "node build/content/new.js",
    "dart-sass": "node build/dart-sass.js",
    "createDist": "mkdir -p ${npm_package_config_path_dist}js && mkdir -p ${npm_package_config_path_dist}css",
    "jshint": "jshint ${npm_package_config_path_src}JavaScript/**/*.js",
    "eslint": "eslint ${npm_package_config_path_src}JavaScript/**/*.js",
    "browserify": "browserify -t [ babelify --presets [ @babel/preset-env ] ] -d ${npm_package_config_path_src}JavaScript/app.js > ${npm_package_config_path_dist}js/app.js",
    "uglify": "uglifyjs ${npm_package_config_path_dist}js/app.js --compress --mangle -o ${npm_package_config_path_dist}js/app.min.js",
    "autoprefixer": "postcss ${npm_package_config_path_dist}css/styles.css --use autoprefixer --map -o ${npm_package_config_path_dist}css/styles.css",
    "minifycss": "css-minify -d ${npm_package_config_path_dist}css -o ${npm_package_config_path_dist}css"
  },
  "devDependencies": {
    "@babel/core": "^7.18.13",
    "@babel/preset-env": "^7.18.10",
    "@typescript-eslint/eslint-plugin": "^5.42.1",
    "@typescript-eslint/parser": "^5.42.1",
    "autoprefixer": "^10.4.8",
    "babelify": "^10.0.0",
    "browserify": "^17.0.0",
    "css-minify": "^2.0.0",
    "eslint": "^8.27.0",
    "fantasticon": "^1.2.3",
    "favicons": "^7.0.0-beta.5",
    "install": "^0.13.0",
    "jshint": "^2.13.5",
    "matchdep": "*",
    "node-sass-glob-importer": "^5.3.2",
    "npm": "^8.18.0",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "postcss": "^8.4.16",
    "postcss-cli": "^10.0.0",
    "sass": "^1.54.5",
    "svgstore": "^3.0.1",
    "uglify-js": "^3.17.0",
    "xliff": "^6.1.0"
  },
  "dependencies": {
    "@babel/plugin-transform-react-jsx": "^7.19.0",
    "@splidejs/splide": "^4.1.4",
    "animejs": "^3.2.1",
    "get-sass-vars": "^3.4.0",
    "jsx-dom": "^8.0.3",
    "node-sass-variables": "^0.0.5",
    "normalize.css": "^8.0.1",
    "rfs": "^9.0.6",
    "smoothscroll-polyfill": "^0.4.4"
  },
  "browserslist": [
    "defaults"
  ]
}
