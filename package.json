{
  "name": "puck",
  "version": "1.0.0",
  "description": "Puck - TYPO3 site package",
  "type": "module",
  "config": {
    "path": {
      "src": "puck/Resources/Private/",
      "dist": "puck/Resources/Public/"
    }
  },
  "engines": {
    "npm": ">=10",
    "node": ">=22"
  },
  "scripts": {
    "watch": "run-p watch:js watch:icons watch:css",
    "watch:dev": "run-p watch:js:dev watch:css:dev watch:icons",
    "build": "run-s createDist build:icons build:js build:css",
    "build:dev": "run-s createDist build:icons build:js:dev build:css:dev",
    "watch:js": "onchange 'puck/Resources/Private/JavaScript/**/*.js' -- run-s build:js",
    "watch:css": "onchange 'puck/Resources/Private/Stylesheets/**/*.s*ss' -- run-s build:css",
    "watch:js:dev": "onchange 'puck/Resources/Private/JavaScript/**/*.js' -- run-s build:js:dev",
    "watch:css:dev": "onchange 'puck/Resources/Private/Stylesheets/**/*.s*ss' -- run-s build:css:dev",
    "watch:icons": "run-p watch:frontend-icons watch:favicons",
    "watch:frontend-icons": "onchange 'puck/Resources/Public/Icons/Frontend/*.svg' -- run-s build:fantasticon build:sprite-sheet && node build/icons.js",
    "watch:favicons": "onchange 'puck/Resources/Public/Icons/Favicons/*.svg' -- run-s build:favicons",
    "build:js": "npm run build:js:dev uglify",
    "build:css": "run-s build:css:dev minifycss",
    "build:js:dev": "node build/javascript.js",
    "build:css:dev": "run-s dart-sass autoprefixer",
    "build:icons": "run-s build:fantasticon build:sprite-sheet build:favicons && run-s build:css",
    "build:favicons": "node build/favicons.js",
    "build:xlf-to-json": "node build/xlf-to-json.js",
    "build:fantasticon": "node build/fantasticon.js",
    "build:sprite-sheet": "node build/sprite-sheet.js",
    "build:content:new": "node build/content/new.js",
    "dart-sass": "node build/dart-sass.js",
    "createDist": "mkdir -p ${npm_package_config_path_dist}JavaScript/dist && mkdir -p ${npm_package_config_path_dist}Css/dist",
    "jshint": "jshint ${npm_package_config_path_src}JavaScript/**/*.js",
    "eslint": "eslint ${npm_package_config_path_src}JavaScript/**/*.js",
    "autoprefixer": "postcss ${npm_package_config_path_dist}Css/dist/puck.css --use autoprefixer --map -o ${npm_package_config_path_dist}Css/dist/puck.css",
    "minifycss": "css-minify -d ${npm_package_config_path_dist}Css/dist -o ${npm_package_config_path_dist}Css/dist"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.9",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/plugin-transform-private-methods": "^7.25.9",
    "@babel/plugin-transform-react-jsx": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "autoprefixer": "^10.4.20",
    "babel-plugin-module-resolver": "^5.0.2",
    "babelify": "^10.0.0",
    "browserify": "^17.0.1",
    "css-minify": "^2.0.2",
    "eslint": "^9.13.0",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "eslint-plugin-import": "^2.31.0",
    "exorcist": "^2.0.0",
    "fantasticon": "^3.0.0",
    "favicons": "^7.2.0",
    "glob": "^11.0.0",
    "install": "^0.13.0",
    "jshint": "^2.13.6",
    "jsx-dom": "^8.1.5",
    "matchdep": "*",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "sass": "^1.80.5",
    "svgstore": "^3.0.1",
    "uglify-js": "^3.19.3",
    "xliff": "^6.2.1"
  },
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "htmx-ext-head-support": "^2.0.2",
    "htmx-ext-preload": "^2.0.1",
    "htmx.org": "^2",
    "normalize.css": "^8.0.1",
    "plyr": "^3.7.8",
    "rfs": "^10.0.0",
    "smoothscroll-polyfill": "^0.4.4"
  },
  "browserslist": [
    "defaults"
  ]
}
